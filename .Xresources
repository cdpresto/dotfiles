! XTerm resources
!
! Remember to run `xrdb -merge ~/.Xresources` after changing anything.
! (Note: -merge is safer than the old `xrdb < .Xresources`, since it
!  updates the running resource DB without wiping unrelated entries
!  set by other apps.)
!
! Tavis Ormandy <taviso@gmail.com>
! Set the default UI font (menus, toolbar, etc)
XTerm*XftFont:                  DejaVu Sans Mono UI:size=10:antialias=true:style=Regular
! set the default font
XTerm*faceName: DejaVu Sans Mono
! NOTE: "Segoe UI" and "Consolas" (used below in vt100.faceName) are
! Microsoft fonts and are unlikely to be installed on Fedora unless you
! explicitly added them. If menu text or terminal text looks like a
! generic fallback font instead of what you expect, run:
!   fc-list | grep -i consolas
!   fc-list | grep -i "segoe"
! and if nothing prints, xterm is silently substituting a default font.
! Consider swapping to something confirmed installed, e.g.:
!   XTerm*vt100.faceName: xft:DejaVu Sans Mono:size=14:antialias=true

! Color of UI Components
XTerm*.SimpleMenu.background:   #ffffff
XTerm*.SimpleMenu.foreground:   #000000
! Tone down the Xaw3D effect.
XTerm*shapeStyle:               Rectangle
XTerm*beNiceToColormap:         false
XTerm*relief:                   None
XTerm*highlightThickness:       0
! Dont automatically jump to the bottom on output, but do on keypress.
XTerm*scrollTtyOutput:          false
XTerm*scrollKey:                true
XTerm*scrollBar:                false
XTerm*eightBitInput:            false
XTerm*cursorBlink:              true
! Dont allow mouse ops - it can be enabled in the view Menu at runtime.
! The reason is it breaks copy/paste if an application requests mouse events,
! because the application gets the event instead of XTerm.
XTerm*allowMouseOps:            false
! Dont change my title by default, this can be re-enabled from the menu.
XTerm*allowTitleOps:            false
XTerm*allowFontOps:             false
! Mouse cursor configuration, I prefer to keep it simple.
XTerm*pointerColor:             white
XTerm*pointerColorBackground:   black
XTerm*pointerShape:             left_ptr
! added by charles
Xcursor.size: 48
Xcursor.theme: Adwaita

! Window size and position (single source of truth now -- the old
! duplicate `xterm*geometry: 50x10+500+500` conflicted with
! vt100.geometry below and has been removed)
XTerm*vt100.geometry:           100x30

! Scrollback buffer
xterm*saveLines: 10000
! end of what charles added

! Only select text, not empty space around it.
XTerm*highlightSelection:       true

! The distance between the edge of the screen and the characters.
XTerm*vt100.internalBorder:     6

! The border around elements.
XTerm*.BorderColor:             #ffffff
XTerm*vt100.BorderColor:        #d0d0d0
XTerm*BorderWidth:              3

! Menu Names, I dont like the default verbose names.
XTerm*.mainMenu.label:          File
XTerm*.vtMenu.label:            Options
XTerm*.fontMenu.label:          View

! You can rename menu entries, like this, I dont know why the menubar
! is called a "toolbar", probably historical reasons.
XTerm*.mainMenu.toolbar.label:  Menubar

! Adjust how the active menu item looks
XTerm*.SimpleMenu.*.shadowWidth: 3
XTerm*.SimpleMenu.*.topShadowPixel: SkyBlue
XTerm*.SimpleMenu.*.bottomShadowPixel: LightSkyBlue

! Try to hide the useless title displayed at the top of menus, I know what
! menu it is because I just clicked it.
XTerm*.*.menuLabel.vertSpace:   0
XTerm*.*.menuLabel.foreground:  #ffffff
XTerm*.*.menuLabel.XftFont:     Courier:size=0

! Space around menu entries.
XTerm*.SimpleMenu.*.topMargin:  0
XTerm*.SimpleMenu.*.bottomMargin: 0
XTerm*.SimpleMenu.*.leftMargin: 32
XTerm*.SimpleMenu.*.rightMargin: 64

! Space around the checkmark in the menus.
XTerm*.SimpleMenu.*.leftWhitespace: 16

! Trim vertical padding around the toolbar, all elements have a form.
XTerm*Form.menubar.vSpace:      0
XTerm*Form.menubar.vertDistance: 0

! Fonts
XTerm*vt100.faceName:           xft:DejaVu Sans Mono:size=18:antialias=true:style=Regular
XTerm*vt100.boldFont:           xft:DejaVu Sans Mono:size=18:antialias=true:style=Bold

! Size and Title
XTerm*title:                    Terminal
XTerm*iconHint:                 /home/taviso/.icons/computer_x11.xpm

! I like bold items to be in bright white, and bold text to actually use
! the bright ANSI slot (this is what makes tw=1;30 in LS_COLORS render as
! a legible gray instead of invisible black -- see notes per-theme below).
XTerm*veryBoldColors:       4
XTerm*colorBDMode:          true
XTerm*colorBD:              #ffffff
XTerm*colorRV:              #ffffff
XTerm*boldColors:           true

! I can see a small line between box characters, this fixes it.
XTerm*forceBoxChars:        true
XTerm*vt100.scaleHeight:    1.04
! This (or similar id) is required for Sixel support.
XTerm*decTerminalID:        vt382
XTerm*termName:              xterm-256color

! =====================================================================
! DEFAULT COLOR SCHEME (fallback for any xterm launched without -class,
! e.g. your fvwm "&Default" menu entry). Same values you had before.
! 0-7:  Black, Red, Green, Yellow, Blue, Purple, Cyan, White
! 8-15: Bright Black, Bright Red, ...
! =====================================================================
XTerm*vt100.background:     #212121
XTerm*vt100.foreground:     #80FF80
XTerm*cursorColor:          #ffffff
XTerm*color0:               #212121
XTerm*color8:               #7f7f7f
XTerm*color1:               #A00000
XTerm*color9:               #FF0000
XTerm*color2:               #00A000
XTerm*color10:              #00FF00
XTerm*color3:               #A0A000
XTerm*color11:              #FFFF00
XTerm*color4:               #0066cc
XTerm*color12:              #5C5CFF
XTerm*color5:               #A000A0
XTerm*color13:              #FF00FF
XTerm*color6:               #00A0A0
XTerm*color14:              #00FFFF
XTerm*color7:               #C0C0C0
XTerm*color15:              #ffffff

! =====================================================================
! PER-THEME PALETTES
! Each block is keyed to a unique -class so it only applies to xterm
! windows launched with that class (see the fvwm menu snippet below).
! Every palette below was chosen/checked so that LS_COLORS values render
! legibly against that theme background:
!   di=1;34 (dir)      -> bold blue   -> renders as color12
!   ln=1;36 (symlink)  -> bold cyan   -> renders as color14
!   so=1;35 (socket)   -> bold magenta-> renders as color13
!   pi=1;33 (pipe)     -> bold yellow -> renders as color11
!   sg=1;32 (setgid)   -> bold green  -> renders as color10
!   su=1;30 (setuid)   -> bold black  -> renders as color8
!   tw=1;30 (sticky/ow)-> bold black  -> renders as color8
!   bd=1;33;41 / cd=1;33;40 -> yellow fg on red/black bg -> color11 on color1/color0
! =====================================================================

! --- Dracula  ---
XTermDracula*background:        #282a36
XTermDracula*foreground:        #f8f8f2
XTermDracula*cursorColor:       #f8f8f2
XTermDracula*color0:            #21222c
XTermDracula*color1:            #ff5555
