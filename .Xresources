XTermDracula*color9:            #ff6e6e
XTermDracula*color10:           #69ff94
XTermDracula*color11:           #ffffa5
XTermDracula*color12:           #d6acff
XTermDracula*color13:           #ff92df
XTermDracula*color14:           #a4ffff
XTermDracula*color15:           #ffffff
